---
import Link from "@components/Link.astro";
import { linkTech, linkCompany, linkLearning, linkOthers } from "@data/links";
---

<footer class="bg-text p-4 text-bg md:p-6 lg:p-8">
  <div class="flex flex-col gap-4 py-4 lg:flex-row lg:justify-between">
    <div class="">
      <h2 class="mb-4 text-lg font-bold">Podia</h2>
      <p class="mb-8 text-accent">
        Build websites, learn development, and grow your skills.
      </p>
    </div>

    <div class="grid grid-cols-3 gap-4 lg:w-1/2">
      <div>
        <h3 class="mb-4 text-sm">Technologies</h3>

        <ul class="flex flex-col gap-4" role="list">
          {linkTech.map((link) => (
            <li>
              <Link url={link.url} label={link.label} className="text-accent" />
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4">Company</h3>

        <ul class="flex flex-col gap-4" role="list">
          {linkCompany.map((link) => (
            <li>
              <Link url={link.url} label={link.label} className="text-accent" />
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4">Learning</h3>

        <ul class="flex flex-col gap-4" role="list">
          {linkLearning.map((link) => (
            <li>
              <Link url={link.url} label={link.label} className="text-accent" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-4 flex flex-col items-center gap-8 border-t border-accent py-8 md:flex-row md:justify-between">
    <nav aria-label="Legal links">
      <ul class="flex gap-12" role="list">
        {linkOthers.map((link) => (
          <li>
            <Link url={link.url} label={link.label} />
          </li>
        ))}
      </ul>
    </nav>

    <small class="opacity-80">&copy; 14BryanEspinoza - 2026</small>
  </div>
</footer>
