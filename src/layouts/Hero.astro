---
import { Picture } from "astro:assets";
import Button from "@components/Button.astro";
import wallpaper from "@assets/wallpaper.png";
---

<section class="grid grid-cols-1 gap-12 bg-back p-8 md:grid-cols-2 lg:gap-24 lg:px-12 lg:py-18">
  <div>
    <h1 class="mb-4 text-3xl font-bold text-text md:leading-10 lg:mb-6 lg:text-5xl lg:leading-16">
      Crea sitios web hermosos con tecnologías web modernas
    </h1>

    <p class="mb-4 text-lg text-text md:leading-8 lg:mb-12 lg:text-xl lg:leading-10">
      Crea HTML semántico, diseños CSS fluidos e experiencias interactivas con
      JavaScript. Cada línea de código se construye con propósito y atención al
      detalle.
    </p>

    <Button
      label="Empieza a crear hoy"
      className="border-none px-6 py-2"
      variant
    />
  </div>

  <figure class="overflow-hidden rounded-md md:max-w-xl">
    <Picture
      src={wallpaper}
      alt="ilustración del hero"
      formats={["avif", "webp"]}
      priority
      class="h-full w-full object-cover"
    />
  </figure>
</section>
