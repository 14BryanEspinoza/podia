---
import { Picture } from "astro:assets";
import Button from "@components/Button.astro";
import Cite from "@components/Cite.astro";
import short from "@assets/short.png";
---

<section
  class="grid grid-cols-1 items-center gap-4 bg-bg-secondary px-8 py-24 text-center md:px-12 lg:grid-cols-2 lg:px-16"
  aria-labelledby="testimonial-title"
>
  <figure class="mx-auto w-44 overflow-hidden rounded-md lg:w-auto">
    <Picture
      src={short}
      alt="Desarrollador frontend trabajando en un proyecto de diseño web responsivo"
      formats={["avif", "webp"]}
      layout="constrained"
      loading="lazy"
      decoding="async"
    />
  </figure>

  <div class="md:mx-auto md:max-w-xl">
    <h2
      id="testimonial-title"
      class="mb-4 text-lg font-bold text-primary md:text-xl lg:text-2xl"
    >
      Historia destacada de un desarrollador
    </h2>

    <Cite />

    <p class="mb-4 text-accent">
      Miles de desarrolladores, desde principiantes hasta profesionales
      experimentados, perfeccionan sus habilidades con Podia. Descubre cómo
      aprender desarrollo web puede abrir puertas que nunca imaginaste.
    </p>

    <Button label="Empieza a crear hoy ->" variant />
  </div>
</section>
