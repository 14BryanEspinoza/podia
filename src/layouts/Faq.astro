---
import { faq } from "@data/faq";
---

<section class="px-8 py-24 md:px-12 lg:px-16" aria-labelledby="faq-title">
  <h2
    id="faq-title"
    class="mb-4 text-xl font-bold text-primary md:text-2xl lg:text-4xl"
  >
    {faq.title}
  </h2>

  <ul role="list" class="flex flex-col gap-4">
    {faq.question.map((item) => (
      <li>
        <details class="rounded-md border border-border bg-bg-secondary p-4">
          <summary class="cursor-pointer p-2 text-primary hover:text-accent">
            {item.summary}
          </summary>
          <p class="mt-4 px-12 text-accent">{item.info}</p>
        </details>
      </li>
    ))}
  </ul>
</section>
