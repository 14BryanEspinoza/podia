---
import ContainerText from "@components/ContainerText.astro";
import Cards from "@components/Cards.astro";
import { products } from "@data/products";
---

<section class="px-8 py-24 md:px-12 lg:px-16" aria-labelledby="products-title">
  <ContainerText
    id="products"
    title={products.title}
    description={products.description}
  />

  <div class="grid-col-1 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    {products.card.map((card) => (
      <Cards
        title={card.title}
        description={card.description}
        icon={card.icon}
      />
    ))}
  </div>
</section>
