---
import ContainerText from "@components/ContainerText.astro";
import Cards from "@components/Cards.astro";
import { books } from "@data/books";
---

<section class="px-8 py-24 md:px-12 lg:px-16">
  <ContainerText {...books} />

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {books.card.map((book) => (
      <Cards {...book} book />
    ))}
  </div>
</section>
