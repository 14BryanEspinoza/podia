---
import { Icon } from "astro-icon/components";
import Link from "@components/Link.astro";
import Button from "@components/Button.astro";
import { linkNavbar } from "@data/links";
---

<header class="sticky top-0 z-40 flex flex-wrap items-center justify-between bg-bg-secondary px-8 py-4 shadow md:flex-nowrap md:px-8">
  <a href={import.meta.env.BASE_URL}>
    <figure class="size-8">
      <img
        src={import.meta.env.BASE_URL + "favicon.png"}
        alt="Ir al inicio"
        loading="eager"
        width="32"
        height="32"
        class="object-contain"
      />
    </figure>
  </a>

  <button
    type="button"
    id="menu-toggle"
    class="md:hidden"
    aria-expanded="false"
    aria-controls="nav-main"
    aria-label="menú de navegación"
  >
    <Icon
      name="lucide:menu"
      class="cursor-pointer text-3xl"
      aria-hidden="true"
    />
  </button>

  <nav
    id="nav-main"
    class="hidden h-[90dvh] w-full flex-col items-center justify-center text-center md:flex md:h-auto md:w-auto"
    aria-label="Navegación Principal"
  >
    <ul role="list" class="md:flex md:items-center md:gap-2 lg:gap-4">
      {linkNavbar.map((link) => (
        <li>
          <Link
            url={link.url}
            label={link.label}
            className="mt-6 md:mt-0 md:ml-2 lg:ml-4"
          />
        </li>
      ))}
      <li>
        <Button
          label="Iniciar sesión"
          className="mt-12 md:mt-0 md:ml-4 lg:ml-8"
        />
      </li>
      <li>
        <Button label="Regístrate gratis" className="mt-6 md:mt-0" variant />
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-main");

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;

    btn?.setAttribute("aria-expanded", String(open));

    nav?.classList.toggle("hidden", !open);
    nav?.classList.toggle("flex", open);
  };

  btn?.addEventListener("click", () => setOpen(!open));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) {
      setOpen(false);
      btn?.focus();
    }
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
