---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  icon: string;
  className?: string;
}

const { title, description, icon, className } = Astro.props as Props;
---

<article class="cursor-pointer rounded-md border border-border bg-bg-secondary p-8 transition-all hover:scale-105">
  <div class="mb-2 flex size-10 items-center justify-center rounded-md bg-primary text-bg">
    <Icon name={icon} class={className} />
  </div>

  <h3 class="mb-4 font-bold text-primary">{title}</h3>

  <p class="text-sm text-text-secondary">{description}</p>
</article>
