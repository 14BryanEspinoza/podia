---
interface Props {
  url: string;
  label: string;
  className?: string;
  skip?: boolean;
}

const baseStyle =
  "inline-block text-sm transition hover:scale-105 hover:underline hover:font-bold hover:text-primary transition-all";
const skipStyle =
  "sr-only text-bg transition focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-6 focus:py-2 focus:rounded-md focus:font-bold focus:bg-primary";

const { url, label, className = "", skip = false } = Astro.props as Props;
---

<a href={url} class={`${skip ? skipStyle : baseStyle} ${className}`}>
  {label}
</a>
