---
import { cite } from "@data/cite";
---

<blockquote class="mb-4 border-l-4 border-l-text-secondary bg-bg p-4 shadow">
  <p class="mb-4 text-text italic">"{cite.cite}"</p>
  <footer class="text-text-secondary">
    <strong>{cite.author}</strong>
    <p class="text-xs">{cite.job}</p>
  </footer>
</blockquote>
